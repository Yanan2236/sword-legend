# This .gitignore is for a Unity project located in ./SwordLegend
# Repo root:
#   sword-legend/
#     .gitignore
#     SwordLegend/

# OS / misc
*.log
.DS_Store
Thumbs.db

# Unity generated folders
/SwordLegend/[Ll]ibrary/
/SwordLegend/[Tt]emp/
/SwordLegend/[Oo]bj/
/SwordLegend/[Bb]uild/
/SwordLegend/[Bb]uilds/
/SwordLegend/[Ll]ogs/
/SwordLegend/[Uu]ser[Ss]ettings/
/SwordLegend/[Mm]emoryCaptures/
/SwordLegend/[Rr]ecordings/
/SwordLegend/.utmp/

# Unity / IDE generated files
/SwordLegend/*.csproj
/SwordLegend/*.unityproj
/SwordLegend/*.sln
/SwordLegend/*.suo
/SwordLegend/*.tmp
/SwordLegend/*.user
/SwordLegend/*.userprefs
/SwordLegend/*.pidb
/SwordLegend/*.booproj
/SwordLegend/*.svd
/SwordLegend/*.pdb
/SwordLegend/*.mdb
/SwordLegend/*.opendb
/SwordLegend/*.VC.db
/SwordLegend/*.pidb.meta
/SwordLegend/*.pdb.meta
/SwordLegend/*.mdb.meta

# Rider / VS
/SwordLegend/.vs/
/SwordLegend/.gradle/
/SwordLegend/.consulo/
/SwordLegend/ExportedObj/
*.DotSettings.user

# Blender temp import files
/SwordLegend/*.blend1
/SwordLegend/*.blend1.meta

# Unity crash files
/SwordLegend/sysinfo.txt
/SwordLegend/mono_crash.*

# Build artifacts
/SwordLegend/*.apk
/SwordLegend/*.aab
/SwordLegend/*.unitypackage
/SwordLegend/*.unitypackage.meta
/SwordLegend/*.app

# Crashlytics
/SwordLegend/crashlytics-build.properties

# TestRunner
/SwordLegend/InitTestScene*.unity*

# Addressables
/SwordLegend/ServerData
/SwordLegend/[Aa]ssets/StreamingAssets/aa*
/SwordLegend/[Aa]ssets/AddressableAssetsData/link.xml*
/SwordLegend/[Aa]ssets/Addressables_Temp*
/SwordLegend/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting
/SwordLegend/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/SwordLegend/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/SwordLegend/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/SwordLegend/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated test scenes
/SwordLegend/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*